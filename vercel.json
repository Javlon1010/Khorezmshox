{
  "version": 2,
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.js", 
      "use": "@vercel/static"
    },
    {
      "src": "images/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/bitiruvchilar",
      "dest": "/bitiruvchilar.html"
    },
    {
      "src": "/fanlar", 
      "dest": "/fanlar.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}